{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "minReadySeconds": {
      "type": "integer",
      "minimum": 0
    },
    "availability": {
      "type": "object",
      "required": [
        "enabled",
        "healthPort",
        "maxSlotLag",
        "requestTimeoutSeconds",
        "periodSeconds",
        "failureThreshold",
        "successThreshold",
        "drainDelaySeconds",
        "terminationGracePeriodSeconds",
        "blockfrostScheme"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "healthPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "maxSlotLag": {
          "type": "integer",
          "minimum": 1
        },
        "requestTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "drainDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "blockfrostScheme": {
          "enum": [
            "auto",
            "http",
            "https"
          ]
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tracing",
        "otlp",
        "resourceAttributes"
      ],
      "properties": {
        "tracing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "endpoint",
            "serviceName",
            "sampleRatio",
            "alwaysSamplePools"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "endpoint": {
              "type": "string"
            },
            "serviceName": {
              "type": "string"
            },
            "sampleRatio": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^(|0(\\.[0-9]+)?|1(\\.0+)?)$"
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ]
            },
            "alwaysSamplePools": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "otlp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint",
            "protocol",
            "logs",
            "metrics",
            "headersSecret"
          ],
          "properties": {
            "endpoint": {
              "type": "string"
            },
            "protocol": {
              "enum": [
                "",
                "grpc",
                "http/protobuf"
              ]
            },
            "logs": {
              "type": "boolean"
            },
            "metrics": {
              "type": "boolean"
            },
            "headersSecret": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "key"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                }
              }
            }
          }
        },
        "resourceAttributes": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[^,=\\s]+$"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
