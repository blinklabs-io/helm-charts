{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "minReadySeconds": {
      "type": "integer",
      "minimum": 0
    },
    "availability": {
      "type": "object",
      "required": [
        "enabled",
        "healthPort",
        "maxSlotLag",
        "requestTimeoutSeconds",
        "periodSeconds",
        "failureThreshold",
        "successThreshold",
        "drainDelaySeconds",
        "terminationGracePeriodSeconds",
        "blockfrostScheme"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "healthPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "maxSlotLag": {
          "type": "integer",
          "minimum": 1
        },
        "requestTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "drainDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "blockfrostScheme": {
          "enum": [
            "auto",
            "http",
            "https"
          ]
        }
      }
    }
  }
}
