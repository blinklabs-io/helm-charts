{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "availability": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxTipAgeSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "cliTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "drainDelaySeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7200
        },
        "shelleyGenesisPath": {
          "type": "string",
          "pattern": "^(/.*)?$"
        }
      }
    },
    "minReadySeconds": {
      "type": "integer",
      "minimum": 0
    },
    "updateStrategy": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "enum": [
            "RollingUpdate",
            "OnDelete"
          ]
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "RollingUpdate",
                "OnDelete"
              ]
            }
          }
        }
      ]
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^(100|[0-9]{1,2})%$"
            }
          ]
        }
      }
    }
  }
}
